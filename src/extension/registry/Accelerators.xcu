<?xml version="1.0" encoding="UTF-8"?>
<!-- Ctrl+V in Writer: a spreadsheet range (Calc, Excel, web page) is pasted as a fully
     formatted native table; everything else goes through LibreOffice's normal paste. -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Accelerators" oor:package="org.openoffice.Office">
  <node oor:name="PrimaryKeys">
    <node oor:name="Modules">
      <node oor:name="com.sun.star.text.TextDocument">
        <node oor:name="V_MOD1" oor:op="replace">
          <prop oor:name="Command"><value xml:lang="en-US">service:org.libreappearance.aura.Aura?smart_paste</value></prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
