{
  "$comment": "Aura design tokens — single source of truth for icons, application colors and document templates.",
  "name": "Aura",
  "version": "0.2.0",
  "ramps": {
    "slate":   ["#F8FAFC", "#F1F5F9", "#E2E8F0", "#CBD5E1", "#94A3B8", "#64748B", "#475569", "#334155", "#1E293B", "#0F172A"],
    "indigo":  ["#EEF2FF", "#E0E7FF", "#C7D2FE", "#A5B4FC", "#818CF8", "#6366F1", "#4F46E5", "#4338CA", "#3730A3", "#312E81"],
    "sky":     ["#F0F9FF", "#E0F2FE", "#BAE6FD", "#7DD3FC", "#38BDF8", "#0EA5E9", "#0284C7", "#0369A1", "#075985", "#0C4A6E"],
    "violet":  ["#F5F3FF", "#EDE9FE", "#DDD6FE", "#C4B5FD", "#A78BFA", "#8B5CF6", "#7C3AED", "#6D28D9", "#5B21B6", "#4C1D95"],
    "rose":    ["#FFF1F2", "#FFE4E6", "#FECDD3", "#FDA4AF", "#FB7185", "#F43F5E", "#E11D48", "#BE123C", "#9F1239", "#881337"],
    "amber":   ["#FFFBEB", "#FEF3C7", "#FDE68A", "#FCD34D", "#FBBF24", "#F59E0B", "#D97706", "#B45309", "#92400E", "#78350F"],
    "emerald": ["#ECFDF5", "#D1FAE5", "#A7F3D0", "#6EE7B7", "#34D399", "#10B981", "#059669", "#047857", "#065F46", "#064E3B"]
  },
  "icons": {
    "light": {
      "source": "images_colibre_svg.zip",
      "target": "images_aura_svg.zip",
      "overrides": {
        "#3a3a38": "#1E293B", "#fafafa": "#FFFFFF", "#797774": "#64748B", "#c8c6c4": "#CBD5E1",
        "#1e8bcd": "#4F46E5", "#0063b1": "#4338CA", "#83beec": "#A5B4FC",
        "#ed8733": "#F59E0B", "#fb983b": "#FBBF24", "#f8db8f": "#FDE68A", "#ed5a33": "#F97316",
        "#ed3d3b": "#F43F5E", "#d42314": "#E11D48", "#ff9198": "#FDA4AF",
        "#18ab50": "#10B981", "#309048": "#059669", "#a1ddaa": "#A7F3D0",
        "#922e9b": "#7C3AED", "#a846b2": "#8B5CF6", "#d492d8": "#C4B5FD"
      }
    },
    "dark": {
      "source": "images_colibre_dark_svg.zip",
      "target": "images_aura_dark_svg.zip",
      "overrides": {
        "#fafafa": "#E2E8F0", "#3a3a38": "#1E293B", "#797774": "#64748B", "#c8c6c4": "#94A3B8",
        "#1e8bcd": "#818CF8", "#0063b1": "#6366F1", "#83beec": "#A5B4FC",
        "#ed8733": "#FBBF24", "#fb983b": "#FCD34D", "#f8db8f": "#FDE68A", "#ed5a33": "#FB923C",
        "#ed3d3b": "#FB7185", "#d42314": "#F43F5E", "#ff9198": "#FDA4AF",
        "#18ab50": "#34D399", "#309048": "#10B981", "#a1ddaa": "#A7F3D0",
        "#922e9b": "#A78BFA", "#a846b2": "#8B5CF6", "#d492d8": "#C4B5FD"
      }
    }
  },
  "colorSchemes": {
    "Aura Light": {
      "DocColor": "#FFFFFF", "AppBackground": "#EEF0F4",
      "DocBoundaries": [false, "#CBD5E1"], "ObjectBoundaries": [true, "#CBD5E1"], "TableBoundaries": [true, "#E2E8F0"],
      "Links": [true, "#4F46E5"], "LinksVisited": [true, "#7C3AED"],
      "Spell": "#F43F5E", "Grammar": "#6366F1", "SmartTags": [true, "#8B5CF6"],
      "Shadow": [true, "#CBD5E1"],
      "WriterTextGrid": "#E2E8F0", "WriterFieldShadings": [true, "#EEF2FF"], "WriterIdxShadings": [true, "#EEF2FF"],
      "WriterDirectCursor": [true, "#4F46E5"], "WriterScriptIndicator": "#10B981",
      "WriterSectionBoundaries": [true, "#E2E8F0"], "WriterHeaderFooterMark": "#A5B4FC", "WriterPageBreaks": "#A5B4FC",
      "CalcGrid": "#E2E8F0", "CalcPageBreak": "#94A3B8", "CalcPageBreakManual": "#4F46E5", "CalcPageBreakAutomatic": "#A5B4FC",
      "CalcHiddenColRow": [true, "#94A3B8"], "CalcTextOverflow": [true, "#F43F5E"], "CalcComments": "#F59E0B",
      "CalcDetective": "#4F46E5", "CalcDetectiveError": "#E11D48", "CalcReference": "#6366F1",
      "CalcNotesBackground": "#FEF3C7", "CalcValue": "#4338CA", "CalcFormula": "#047857", "CalcText": "#0F172A",
      "CalcProtectedBackground": "#F1F5F9", "DrawGrid": [true, "#94A3B8"]
    },
    "Aura Dark": {
      "$extends": "Aura Light",
      "$comment": "Dark chrome and canvas, the page stays paper-white so document colours stay true.",
      "AppBackground": "#0B0D10", "Shadow": [true, "#000000"]
    }
  },
  "chrome": {
    "$comment": "GTK theme for LibreOffice's own windows (Linux). Keys become @aura_<key> colours.",
    "font": "Inter 10",
    "light": {
      "base": "Adwaita",
      "window_bg": "#FFFFFF", "view_bg": "#FFFFFF", "surface": "#F1F5F9", "surface_strong": "#E2E8F0",
      "border": "#E2E8F0", "border_strong": "#CBD5E1",
      "fg": "#0F172A", "fg_muted": "#64748B", "insensitive_fg": "#A0AEC0",
      "accent": "#4F46E5", "accent_hover": "#4338CA", "accent_soft": "#EEF2FF", "selected_fg": "#FFFFFF",
      "tooltip_bg": "#0F172A", "tooltip_fg": "#F8FAFC"
    },
    "dark": {
      "base": "Adwaita-dark",
      "window_bg": "#16181D", "view_bg": "#1C1F26", "surface": "#232733", "surface_strong": "#2C3140",
      "border": "#2A2F3A", "border_strong": "#3A4150",
      "fg": "#E2E8F0", "fg_muted": "#94A3B8", "insensitive_fg": "#5B6474",
      "accent": "#818CF8", "accent_hover": "#A5B4FC", "accent_soft": "#262B48", "selected_fg": "#0B0D10",
      "tooltip_bg": "#E2E8F0", "tooltip_fg": "#0F172A"
    }
  },
  "typography": {
    "sans": "Inter",
    "display": "Inter Display",
    "sansSemibold": "Inter SemiBold",
    "displaySemibold": "Inter Display SemiBold",
    "mono": "DejaVu Sans Mono",
    "fallbackSans": "Carlito"
  },
  "document": {
    "ink": "#0F172A", "text": "#1E293B", "muted": "#64748B", "subtle": "#94A3B8",
    "hairline": "#E2E8F0", "surface": "#F8FAFC", "surfaceAlt": "#F1F5F9",
    "accent": "#4F46E5", "accentSoft": "#EEF2FF", "accentStrong": "#3730A3",
    "success": "#047857", "successSoft": "#ECFDF5",
    "warning": "#B45309", "warningSoft": "#FFFBEB",
    "danger": "#BE123C", "dangerSoft": "#FFF1F2"
  }
}
