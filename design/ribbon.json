            "Shapes"
          ]
        },
        {
          "from": "InsertLabel",
          "drop": [
            "Insert-Section-LineToolbox",
            "Insert-Section-BasicShapes",
            "Insert-Section-FlowChartShapes",
            "Insert-Section-FlowChartShapes1"
          ]
        }
      ]
    }
  }
}
