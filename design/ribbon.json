        ".uno:CellVertBottom",
        ".uno:InsertAVMedia",
        ".uno:InsertObjectChart",
        ".uno:InsertTable",
        ".uno:InsertGraphic"
      ],
      "split": [
        {
          "from": "InsertLabel",
          "id": "AuraShapesLabel",
          "sections": [
            "Insert-Section-DrawText",
            "Insert-Section-LineToolbox",
            "Insert-Section-BasicShapes",
            "Insert-Section-FlowChartShapes",
            "Insert-Section-FlowChartShapes1"
          ],
          "label": [
            "notebookbar_groups|shapesb",
            "Shapes"
          ]
        },
        {
          "from": "LayoutLabel",
          "id": "AuraArrangeLabel",
          "sections": [
            "Layout-Section-SelectGroup",
            "Layout-Section-SelectGroup1",
            "Layout-Section-ToggleObjectRotateMode",
            "Layout-Section-ObjectAlign",
            "Layout-Section-ObjectPosition"
          ],
