{
  "$comment": "Aura ribbon (Tabbed Compact). 'labels' are per-language corrections of stock labels, keyed by the label's translation context (text after '|'). 'hide' tidies buttons off the Home tab. 'split' moves sections of a crowded tab into a new themed tab (inserted right after it) so every tool shows without the overflow chevron; its 'label' is a [msgctxt, msgid] pair that already exists in LibreOffice's catalog for the module, so the tab is translated in every UI language. 'drop' removes duplicate sections. build_ribbon.py fails unless every command of the stock ribbon is still in the new ribbon. 'fix' replaces commands that are dead in the stock ribbon by the working equivalent (verified by tools/test_commands.py).",
  "modules": {
    "swriter": {
      "home": "HomeLabel",
      "labels": {
        "fr": {
          "HomeLabel": "~Accueil",
          "ExtensionLabel": "E~xtensions",
          "HomeMenuButton": "_Accueil"
        }
      },
      "hide": [
        ".uno:ParaLeftToRight",
        ".uno:ParaRightToLeft",
        ".uno:InsertTable",
        ".uno:InsertGraphic",
        ".uno:InsertPagebreak",
        ".uno:CharmapControl"
      ],
      "split": [
        {
          "from": "InsertLabel",
          "id": "AuraShapesLabel",
          "sections": [
            "DrawTexSection",
            "DrawTexSection1",
            "DrawSection1",
            "DrawSection2",
            "DrawSection3"
          ],
          "label": [
            "notebookbar_groups|shapesb",
            "Shapes"
          ]
        },
        {
          "from": "LayoutLabel",
          "id": "AuraParagraphLabel",
          "sections": [
            "Layout-Section-LeftParaMargin",
            "Layout-Section-RightParaMargin",
            "Layout-Section-AboveSpacing",
            "Layout-Section-BelowSpacing"
          ],
          "label": [
            "paradialog|ParagraphPropertiesDialog",
            "Paragraph"
          ]
        },
        {
          "from": "LayoutLabel",
          "id": "AuraArrangeLabel",
          "sections": [
            "Layout-Section-SelectGroup",
            "Layout-Section-SelectGroup1",
            "Layout-Section-ObjectAlign",
            "Layout-Section-Forward",
            "Layout-Section-Backward"
          ],
          "label": [
            "notebookbar_groupedbar_compact|ArrangeButton",
            "_Arrange"
          ]
        },
        {
          "from": "ReferencesLabel",
          "id": "AuraBibliographyLabel",
          "sections": [
            "References-Section-Bibliothek",
            "References-Section-Bibliothek1",
            "References-Section-Database",
            "References-Section-Database1"
          ],
          "label": [
            "STR_TOX_AUTH",
            "Bibliography"
          ]
        },
        {
          "from": "ReviewLabel",
          "id": "AuraTrackLabel",
          "sections": [
            "Review-Section-Review1",
            "Review-Section-Review2",
            "Review-Section-Review3",
            "Review-Section-Review4",
            "Review-Section-AcceptTrackedChanges",
            "Review-Section-Compare",
            "Review-Section-Compare1",
            "Review-Section-Compare2"
          ],
          "label": [
            "STR_HIDDEN_CHANGES",
            "Track Changes"
          ]
        }
      ]
    },
    "scalc": {
      "home": "HomeLabel",
      "labels": {
        "fr": {
          "CalcLabel": "~Accueil",
          "ExtensionLabel": "E~xtensions"
        }
      },
      "hide": [
        ".uno:SubScript",
        ".uno:SuperScript",
        ".uno:InsertCell"
      ],
      "split": [
        {
          "from": "HomeLabel",
          "id": "AuraCellsLabel",
          "sections": [
            "Home-Section-Row",
            "Home-Section-Column",
            "Home-Section-MergeCells",
            "Home-Section-InsertCellDialog",
            "Home-Section-NumberFormat",
            "Home-Section-NumberFormat1",
            "Home-Section-Conditional",
            "Home-Section-StyleDropdown",
            "Home-Section-StyleParagraph",
            "Home-Section-StyleParagraph1"
          ],
          "label": [
            "notebookbar_groupedbar_full|cellb",
            "_Cells"
          ]
        },
        {
          "from": "InsertLabel",
          "id": "AuraShapesLabel",
          "sections": [
            "DrawTexSection",
            "DrawSection1",
            "DrawSection2",
            "DrawSection3"
          ],
          "label": [
            "notebookbar_groups|shapesb",
            "Shapes"
          ]
        },
        {
          "from": "ReviewLabel",
          "id": "AuraTrackLabel",
          "sections": [
            "Review-Section-TrackChanges",
            "Review-Section-TrackChanges1",
            "Review-Section-Compare",
            "Review-Section-Compare1",
            "Review-Section-Compare2"
          ],
          "label": [
            "conflictsdialog|changes-atkobject",
            "Changes"
          ]
        },
        {
          "from": "ViewLabel",
          "id": "AuraWindowLabel",
          "sections": [
            "View-Section-Freeze",
            "View-Section-Freeze1",
            "View-Section-Bars",
            "View-Section-Bars1",
            "View-Section-NewWindow"
          ],
          "label": [
            "tpviewpage|label5",
            "Window"
          ]
        }
      ],
      "fix": {
        ".uno:InsertQrCodeD": ".uno:InsertQrCode",
        ".uno:DeleteComment": ".uno:DeleteNote",
        ".uno:SpellingAndGrammarDialog": ".uno:SpellDialog",
        ".uno:InsertPivotTableNBLabel": ".uno:DataDataPilotRun"
      }
    },
    "simpress": {
      "home": "HomeLabel",
      "labels": {
        "fr": {
          "HomeLabel": "~Accueil",
          "ExtensionLabel": "E~xtensions",
          "HomeMenuButton": "_Accueil"
